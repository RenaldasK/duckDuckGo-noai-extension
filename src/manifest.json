{
  "manifest_version": 3,
  "name": "Custom DuckDuckGo No-AI",
  "version": "1.0",
  "description": "Customized new tab with image background and No-AI search.",
  "chrome_settings_overrides": {
    "search_provider": {
      "encoding": "UTF-8",
      "favicon_url": "https://noai.duckduckgo.com/favicon.ico",
      "is_default": true,
      "keyword": "noai",
      "name": "DuckDuckGo (No AI)",
      "search_url": "https://noai.duckduckgo.com/?t=chromenoai&q={searchTerms}",
      "suggest_url": "https://noai.duckduckgo.com/ac/?q={searchTerms}&type=list"
    }
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "128": "img/icon_128.png",
    "16": "img/icon_16.png",
    "48": "img/icon_48.png"
  }
}
